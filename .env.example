# Variables nuevas del sistema de registro (Discord <-> Albion). Los valores son ejemplos, no secretos.

# Canal de texto (ID) donde los oficiales verifican los registros y se avisan las vinculaciones/desvinculaciones.
# También se puede cambiar desde Discord con /registro_canal.
REGISTRO_CANAL_ID=0

# Guild de Albion que se exige para registrarse (por defecto usa ALBION_GUILD_NAME). Vacío = no exigir guild.
# REGISTRO_GUILD=Smogg

# 1 = exigir estar registrado para usar los comandos de miembros desde el arranque.
# Por defecto está APAGADO; se activa/desactiva con /registro_obligatorio.
# REGISTRO_OBLIGATORIO=1
