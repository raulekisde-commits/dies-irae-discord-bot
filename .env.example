# Variables del sistema de registro (Discord <-> Albion). Los valores son ejemplos, no secretos.

# Canal de texto (ID) donde el bot avisa los registros y desvinculaciones.
# También se puede cambiar desde Discord con /registro_canal.
REGISTRO_CANAL_ID=0

# Guild de Albion que se exige para registrarse (por defecto usa ALBION_GUILD_NAME). Vacío = no exigir guild.
# REGISTRO_GUILD=Smogg

# 1 = exigir estar registrado para usar los comandos de miembros desde el arranque.
# Por defecto es OBLIGATORIO estar registrado para usar los comandos; un admin puede apagarlo con /registro_obligatorio desactivar.
# REGISTRO_OBLIGATORIO=0   # fuerza apagado (emergencia)
